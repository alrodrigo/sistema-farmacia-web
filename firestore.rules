rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Función para verificar si existe el documento del usuario en users
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Función para obtener datos del usuario autenticado de forma segura
    function getUserData() {
      return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    // Función para verificar si el usuario es admin
    function isAdmin() {
      return isSignedIn() && (
        !userDocExists() || 
        getUserData().get('role', '') == 'admin'
      );
    }

    // Función para verificar si el usuario es parte del personal (admin, empleado, vendedor, cajero)
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        getUserData().get('role', '') in ['admin', 'empleado', 'vendedor', 'cajero', 'personalizado']
      );
    }
    
    // Función para verificar si el usuario tiene un permiso granular específico (PBAC)
    function hasPermission(permission) {
      return isSignedIn() && (
        isAdmin() || 
        (isStaff() && (permission == 'realizar_ventas' || permission == 'ver_productos')) ||
        (getUserData().get('permissions', []).hasAny([permission])) ||
        (getUserData().get('permisos', []).hasAny([permission]))
      );
    }
    
    // USUARIOS - Gestión de cuentas y asignación de permisos
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if request.auth.uid == userId || isAdmin() || hasPermission('gestionar_usuarios');
      allow update, delete: if isAdmin() || hasPermission('gestionar_usuarios') || request.auth.uid == userId;
    }
    
    // CATEGORÍAS
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_categorias');
    }
    match /categorias/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_categorias');
    }
    
    // PROVEEDORES / LABORATORIOS
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_proveedores');
    }
    match /proveedores/{proveedorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_proveedores');
    }
    
    // PRODUCTOS - Admin/gestores administran catálogo; cualquier usuario autenticado puede actualizar stock
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || hasPermission('gestionar_productos');
      allow update: if isSignedIn();
    }
    
    // VENTAS - Cualquier usuario autenticado del sistema puede registrar una venta
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    // ITEMS DE VENTA
    match /sale_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    // MOVIMIENTOS DE INVENTARIO
    match /inventory_movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}