rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Función para obtener datos del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Función para verificar si el usuario es admin
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    
    // Función para verificar si el usuario tiene un permiso granular específico (PBAC)
    function hasPermission(permission) {
      return isSignedIn() && (
        isAdmin() || 
        (getUserData().permissions != null && permission in getUserData().permissions)
      );
    }

    // Función para verificar si el usuario es empleado o admin
    function isEmployee() {
      return isSignedIn() && (
        getUserData().role in ['admin', 'empleado', 'personalizado']
      );
    }
    
    // USUARIOS - Gestión de cuentas y asignación de permisos
    match /users/{userId} {
      allow read: if isSignedIn();
      // Permitir crear si es el propio usuario registrándose o un admin / gestor de usuarios
      allow create: if request.auth.uid == userId || isAdmin() || hasPermission('gestionar_usuarios');
      allow update, delete: if isAdmin() || hasPermission('gestionar_usuarios') || request.auth.uid == userId;
    }
    
    // CATEGORÍAS
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_categorias');
    }
    match /categorias/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_categorias');
    }
    
    // PROVEEDORES / LABORATORIOS
    match /suppliers/{supplierId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_proveedores');
    }
    match /proveedores/{proveedorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasPermission('gestionar_proveedores');
    }
    
    // PRODUCTOS - Control granular por gestionar_productos y descuento de stock por realizar_ventas
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || hasPermission('gestionar_productos');
      allow update: if isAdmin() || hasPermission('gestionar_productos') || hasPermission('realizar_ventas');
    }
    
    // VENTAS - Permitir cobrar si tiene realizar_ventas
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || hasPermission('realizar_ventas');
      allow update, delete: if isAdmin();
    }
    
    // ITEMS DE VENTA - Relacionados con ventas
    match /sale_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || hasPermission('realizar_ventas');
      allow update, delete: if isAdmin();
    }
    
    // MOVIMIENTOS DE INVENTARIO
    match /inventory_movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || hasPermission('gestionar_productos') || hasPermission('realizar_ventas');
      allow update, delete: if isAdmin();
    }
  }
}